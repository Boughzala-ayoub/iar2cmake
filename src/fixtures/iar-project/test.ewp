<?xml version="1.0" encoding="iso-8859-1"?>
<project>
  <fileVersion>2</fileVersion>
  <configuration>
    <name>Debug</name>
    <toolchain>
      <name>ARM</name>
    </toolchain>
    <settings>
      <name>General</name>
      <archiveVersion>3</archiveVersion>
      <data>
        <version>3</version>
        <general>
          <processor>
            <id>0</id>
            <name>ARM Cortex-M4</name>
          </processor>
          <core>
            <variant>0</varname>
          </core>
          <device>
            <name>STM32F429ZIT6</name>
            <description>STM32F429ZIT6</description>
            <deviceFile>io430.h</deviceFile>
            <vendor>ST</vendor>
          </device>
        </general>
        <option>
          <name>OCDDFTarget</name>
          <state>STM32F429ZIT6</state>
        </option>
      </data>
    </settings>
    <settings>
      <name>ICCARM</name>
      <archiveVersion>3</archiveVersion>
      <data>
        <version>3</version>
        <option>
          <name>CCDefines</name>
          <state>USE_HAL_DRIVER</state>
          <state>STM32F429xx</state>
        </option>
        <option>
          <name>CCIncludePath2</name>
          <state>$PROJ_DIR$\Inc</state>
          <state>$PROJ_DIR$\Drivers\CMSIS\Include</state>
          <state>$PROJ_DIR$\Drivers\STM32F4xx_HAL_Driver\Inc</state>
        </option>
        <option>
          <name>CCStdLibSelection</name>
          <state>0</state>
        </option>
        <option>
          <name>CCAllowList</name>
          <state>0</state>
        </option>
        <option>
          <name>CCCompilerLanguage</name>
          <state>2</state>
        </option>
        <option>
          <name>CCOptimizationLevel</name>
          <state>3</state>
        </option>
      </data>
    </settings>
    <settings>
      <name>AARM</name>
      <archiveVersion>3</archiveVersion>
      <data>
        <version>3</version>
        <option>
          <name>AADefines</name>
        </option>
      </data>
    </settings>
    <settings>
      <name>Ilink</name>
      <archiveVersion>3</archiveVersion>
      <data>
        <version>3</version>
        <option>
          <name>IlinkIcfFile</name>
          <state>$PROJ_DIR$\STM32F429ZIT6_FLASH.icf</state>
        </option>
        <option>
          <name>IlinkStackSize</name>
          <state>0x400</state>
        </option>
        <option>
          <name>IlinkHeapSize</name>
          <state>0x200</state>
        </option>
      </data>
    </settings>
    <settings>
      <name>BARM</name>
      <archiveVersion>3</archiveVersion>
      <data>
        <version>3</version>
      </data>
    </settings>
  </configuration>
  <configuration>
    <name>Release</name>
    <toolchain>
      <name>ARM</name>
    </toolchain>
    <settings>
      <name>General</name>
      <archiveVersion>3</archiveVersion>
      <data>
        <version>3</version>
        <general>
          <device>
            <name>STM32F429ZIT6</name>
          </device>
        </general>
      </data>
    </settings>
    <settings>
      <name>ICCARM</name>
      <archiveVersion>3</archiveVersion>
      <data>
        <version>3</version>
        <option>
          <name>CCDefines</name>
          <state>USE_HAL_DRIVER</state>
          <state>STM32F429xx</state>
          <state>NDEBUG</state>
        </option>
        <option>
          <name>CCIncludePath2</name>
          <state>$PROJ_DIR$\Inc</state>
          <state>$PROJ_DIR$\Drivers\CMSIS\Include</state>
        </option>
        <option>
          <name>CCOptimizationLevel</name>
          <state>7</state>
        </option>
      </data>
    </settings>
  </configuration>
  <group>
    <name>Application</name>
    <group>
      <name>User</name>
      <file>
        <name>$PROJ_DIR$\Src\main.c</name>
      </file>
      <file>
        <name>$PROJ_DIR$\Src\stm32f4xx_it.c</name>
      </file>
      <file>
        <name>$PROJ_DIR$\Src\stm32f4xx_hal_msp.c</name>
      </file>
    </group>
    <group>
      <name>Startup</name>
      <file>
        <name>$PROJ_DIR$\Startup\startup_stm32f429xx.s</name>
      </file>
    </group>
    <file>
      <name>$PROJ_DIR$\Src\system_stm32f4xx.c</name>
    </file>
  </group>
</project>
